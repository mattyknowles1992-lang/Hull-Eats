{
  "name": "hull-eats-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm exec turbo run build",
    "dev": "pnpm exec turbo run dev --parallel",
    "lint": "pnpm exec turbo run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @hull-eats/db prisma:generate",
    "db:migrate": "pnpm --filter @hull-eats/db prisma:migrate",
    "db:seed": "pnpm --filter @hull-eats/db seed",
    "db:diff": "node ./packages/db/node_modules/dotenv-cli/cli.js -e ./.env -- node ./packages/db/node_modules/prisma/build/index.js migrate diff --from-schema-datasource ./packages/db/prisma/schema.prisma --to-schema-datamodel ./packages/db/prisma/schema.prisma --script",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "geo:generate-hull-sectors": "node scripts/generate-hull-sector-geocodes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  }
}
