{
  "name": "@hull-eats/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:diff": "dotenv -e ../../.env -- prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "tsx scripts/migrate-deploy.ts",
    "prisma:migrate:status": "tsx scripts/migrate-status.ts",
    "db:check": "tsx scripts/verify-database.ts",
    "db:provision-cheeky-chicken": "tsx scripts/provision-cheeky-chicken-hub.ts",
    "db:activate-cheeky-chicken-menu": "tsx scripts/activate-cheeky-chicken-menu.ts",
    "db:baseline": "tsx scripts/baseline-and-deploy.ts",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hull-eats/auth": "workspace:*",
    "@hull-eats/types": "workspace:*",
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4"
  }
}

