generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN   @map("platform_admin")
  MERCHANT_MANAGER @map("merchant_manager")
  MERCHANT_STAFF   @map("merchant_staff")
  COURIER          @map("courier")
  CUSTOMER         @map("customer")

  @@map("user_role")
}

enum MembershipRole {
  OWNER   @map("owner")
  MANAGER @map("manager")
  STAFF   @map("staff")

  @@map("membership_role")
}

enum HubUserStatus {
  ACTIVE   @map("active")
  INVITED  @map("invited")
  DISABLED @map("disabled")

  @@map("hub_user_status")
}

enum ServiceBusinessStatus {
  PENDING  @map("pending")
  VERIFIED @map("verified")
  PAUSED   @map("paused")
  REJECTED @map("rejected")

  @@map("service_business_status")
}

enum StoreType {
  RESTAURANT @map("restaurant")
  TAKEAWAY   @map("takeaway")
  SHOP       @map("shop")

  @@map("store_type")
}

enum StorefrontStatus {
  ONBOARDING @map("onboarding")
  LIVE       @map("live")
  PAUSED     @map("paused")

  @@map("storefront_status")
}

enum FulfillmentType {
  DELIVERY @map("delivery")
  PICKUP   @map("pickup")

  @@map("fulfillment_type")
}

enum OrderSource {
  WEB          @map("web")
  IOS_APP      @map("ios_app")
  ANDROID_APP  @map("android_app")
  ADMIN_PORTAL @map("admin_portal")
  KIOSK        @map("kiosk")

  @@map("order_source")
}

enum OrderStatus {
  PENDING            @map("pending")
  ACCEPTED           @map("accepted")
  REJECTED           @map("rejected")
  PREPARING          @map("preparing")
  READY_FOR_DISPATCH @map("ready_for_dispatch")
  ASSIGNED           @map("assigned")
  COURIER_ACCEPTED   @map("courier_accepted")
  PICKED_UP          @map("picked_up")
  DELIVERED          @map("delivered")
  CANCELLED          @map("cancelled")

  @@map("order_status")
}

enum PaymentStatus {
  PENDING    @map("pending")
  AUTHORIZED @map("authorized")
  PAID       @map("paid")
  FAILED     @map("failed")
  REFUNDED   @map("refunded")

  @@map("payment_status")
}

enum DeliveryStatus {
  UNASSIGNED @map("unassigned")
  ASSIGNED   @map("assigned")
  ACCEPTED   @map("accepted")
  PICKED_UP  @map("picked_up")
  DELIVERED  @map("delivered")
  FAILED     @map("failed")

  @@map("delivery_status")
}

enum DriverStatus {
  OFFLINE     @map("offline")
  AVAILABLE   @map("available")
  ON_DELIVERY @map("on_delivery")

  @@map("driver_status")
}

enum PrinterAdapterType {
  MOCK            @map("mock")
  NETWORK_ESC_POS @map("network_esc_pos")
  CLOUD_BRIDGE    @map("cloud_bridge")

  @@map("printer_adapter_type")
}

enum PrintJobStatus {
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")

  @@map("print_job_status")
}

enum StockStatus {
  IN_STOCK     @map("in_stock")
  LOW_STOCK    @map("low_stock")
  OUT_OF_STOCK @map("out_of_stock")

  @@map("stock_status")
}

enum MenuImportSourceType {
  IMAGE @map("image")
  TEXT  @map("text")

  @@map("menu_import_source_type")
}

enum MenuImportStatus {
  PENDING_REVIEW @map("pending_review")
  APPLIED        @map("applied")
  DISCARDED      @map("discarded")

  @@map("menu_import_status")
}

enum StorePromotionKind {
  BOGO_ITEM
  PERCENT_OFF
  FIXED_AMOUNT_ITEM
  BUNDLE_FIXED_PRICE

  @@map("store_promotion_kind")
}

enum StorePromotionScope {
  ITEMS
  CATEGORIES
  WHOLE_MENU

  @@map("store_promotion_scope")
}

enum CustomerAddressType {
  HOME
  WORK
  OTHER
}

enum PaymentProvider {
  DOJO   @map("dojo")
  STRIPE @map("stripe")

  @@map("payment_provider")
}

enum PaymentRecordStatus {
  REQUIRES_PAYMENT_METHOD @map("requires_payment_method")
  REQUIRES_CONFIRMATION   @map("requires_confirmation")
  REQUIRES_ACTION         @map("requires_action")
  PROCESSING              @map("processing")
  SUCCEEDED               @map("succeeded")
  CANCELED                @map("canceled")
  FAILED                  @map("failed")
  REFUNDED                @map("refunded")

  @@map("payment_record_status")
}

enum PaymentMethodType {
  CARD             @map("card")
  APPLE_PAY        @map("apple_pay")
  GOOGLE_PAY       @map("google_pay")
  CASH_ON_DELIVERY @map("cash_on_delivery")

  @@map("payment_method_type")
}

enum OrderPaymentMethod {
  DOJO_CARD        @map("dojo_card")
  CASH_ON_DELIVERY @map("cash_on_delivery")
  MANUAL_INVOICE   @map("manual_invoice")

  @@map("order_payment_method")
}

enum InventoryAdjustmentReason {
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  RESTOCK
  STOCKTAKE
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  phone               String?
  fullName            String                @map("full_name")
  role                UserRole
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  merchantMemberships MerchantMembership[]
  courierProfile      CourierProfile?
  courierAccount      CourierAccount?
  assignedDeliveries  Delivery[]            @relation("DeliveryAssignedBy")
  orderStatusHistory  OrderStatusHistory[]
  deliveryStatusLogs  DeliveryStatusHistory[]
  inventoryAdjustments InventoryAdjustment[]
  serviceBusinesses   ServiceBusiness[]     @relation("ServiceBusinessOwner")

  @@map("platform_users")
}

model CustomerProfile {
  id                 String            @id @default(cuid())
  supabaseAuthUserId String            @unique
  email              String            @unique
  fullName           String?
  phone              String?
  marketingOptIn     Boolean           @default(false)
  stripeCustomerId   String?           @unique
  defaultAddressId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  defaultAddress     CustomerAddress?  @relation("CustomerDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  addresses          CustomerAddress[]
  orders             Order[]
  payments           Payment[]
  resaleListings     ResaleListing[]    @relation("ResaleListingSeller")
  resaleConversationsAsBuyer ResaleConversation[] @relation("ResaleConversationBuyer")
  resaleConversationsAsSeller ResaleConversation[] @relation("ResaleConversationSeller")
  resaleMessagesSent ResaleMessage[]   @relation("ResaleMessageSender")
  resaleOffersMade   ResaleOffer[]     @relation("ResaleOfferAuthor")
  resalePurchasesAsBuyer ResalePurchase[] @relation("ResalePurchaseBuyer")
  resaleReviewsWritten ResaleReview[]   @relation("ResaleReviewAuthor")
  resaleResolutionCasesOpened ResaleResolutionCase[] @relation("ResaleResolutionOpener")
}

model CustomerAddress {
  id                 String            @id @default(cuid())
  customerProfileId  String
  label              String
  type               CustomerAddressType
  fullName           String
  phone              String
  addressLine1       String
  addressLine2       String?
  city               String
  postcode           String
  deliveryNotes      String?
  isDefault          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  customerProfile    CustomerProfile   @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  defaultForProfiles CustomerProfile[] @relation("CustomerDefaultAddress")
  orders             Order[]
}

model Merchant {
  id           String                @id @default(uuid()) @db.Uuid
  slug         String                @unique
  name         String
  supportEmail String?               @map("support_email")
  supportPhone String?               @map("support_phone")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  stores       Store[]
  memberships  MerchantMembership[]
  mediaAssets  MediaAsset[]
  hubUsers     HubUser[]

  @@map("businesses")
}

model MerchantMembership {
  id         String         @id @default(cuid())
  userId     String
  merchantId String
  role       MembershipRole
  createdAt  DateTime       @default(now())
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
}

model Store {
  id                String             @id @default(uuid()) @db.Uuid
  merchantId        String             @map("business_id") @db.Uuid
  slug              String             @unique
  name              String
  type              StoreType
  storefrontStatus  StorefrontStatus   @default(ONBOARDING) @map("storefront_status")
  menuSetupComplete Boolean            @default(false) @map("menu_setup_complete")
  addressLine1      String             @map("address_line_1")
  city              String
  postcode          String
  timezone          String             @default("Europe/London")
  shortDescription  String?            @map("short_description")
  cuisineLabel      String?            @map("cuisine_label")
  onboardingMessage String?            @map("onboarding_message")
  heroImageUrl      String?            @map("hero_image_url")
  deliveryFee       Decimal            @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  minimumOrderAmount Decimal           @default(0) @map("minimum_order_amount") @db.Decimal(10, 2)
  etaMinutes        Int?               @map("eta_minutes")
  autoAcceptOrders       Boolean       @default(false) @map("auto_accept_orders")
  autoAcceptMaxPrepMinutes Int         @default(60) @map("auto_accept_max_prep_minutes")
  deliveryConfig    Json?              @map("delivery_config")
  logoAssetId       String?            @map("logo_asset_id")
  coverAssetId      String?            @map("cover_asset_id")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  merchant          Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  logoAsset         MediaAsset?        @relation("StoreLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  coverAsset        MediaAsset?        @relation("StoreCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  storeHours        StoreHour[]
  deliveryZones     DeliveryZone[]
  menuCategories    MenuCategory[]
  orders            Order[]
  printers          Printer[]
  uploadedAssets    MediaAsset[]       @relation("StoreAssets")
  menuImportBatches MenuImportBatch[]
  promotions        StorePromotion[]
  courierAssignments StoreCourierAssignment[]

  @@map("stores")
}

model StoreCourierAssignment {
  id               String           @id @default(cuid())
  storeId          String           @map("store_id") @db.Uuid
  courierProfileId String           @map("courier_profile_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  courierProfile   CourierProfile   @relation(fields: [courierProfileId], references: [id], onDelete: Cascade)

  @@unique([storeId, courierProfileId])
  @@index([courierProfileId])
  @@map("store_courier_assignments")
}

model StorePromotion {
  id                 String              @id @default(uuid()) @db.Uuid
  storeId            String              @map("store_id") @db.Uuid
  title              String
  isActive           Boolean             @default(true) @map("is_active")
  kind               StorePromotionKind
  scope              StorePromotionScope
  percentOff         Decimal?            @map("percent_off") @db.Decimal(5, 2)
  fixedAmountOff     Decimal?            @map("fixed_amount_off") @db.Decimal(10, 2)
  bundleFixedPrice   Decimal?            @map("bundle_fixed_price") @db.Decimal(10, 2)
  menuItemIds        String[]            @default([]) @map("menu_item_ids")
  categoryIds        String[]            @default([]) @map("category_ids")
  bundleLines        Json?               @map("bundle_lines")
  validDates         String[]            @map("valid_dates")
  dailyStartTime     String?             @map("daily_start_time")
  dailyEndTime       String?             @map("daily_end_time")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_promotions")
}

model StoreHour {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  openTime  String   @map("open_time")
  closeTime String   @map("close_time")
  isClosed  Boolean  @default(false) @map("is_closed")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_hours")
}

model DeliveryZone {
  id                 String   @id @default(cuid())
  storeId            String
  name               String
  postcodePatterns   String[]
  minimumOrderAmount Decimal  @db.Decimal(10, 2)
  deliveryFee        Decimal  @db.Decimal(10, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders             Order[]
}

model MediaAsset {
  id                String     @id @default(cuid())
  merchantId        String?
  storeId           String?
  url               String
  altText           String?
  mimeType          String?
  width             Int?
  height            Int?
  purpose           String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  merchant          Merchant?  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store             Store?     @relation("StoreAssets", fields: [storeId], references: [id], onDelete: Cascade)
  logoForStores     Store[]    @relation("StoreLogo")
  coverForStores    Store[]    @relation("StoreCover")
  menuItemPrimary   MenuItem[] @relation("MenuItemPrimaryImage")
}

model MenuCategory {
  id         String     @id @default(uuid()) @db.Uuid
  storeId    String     @map("store_id") @db.Uuid
  name       String
  description String?
  defaultPrice Decimal?   @map("default_price") @db.Decimal(10, 2)
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id                   String                 @id @default(uuid()) @db.Uuid
  categoryId           String                 @map("category_id") @db.Uuid
  primaryImageAssetId  String?                @map("primary_image_asset_id")
  sku                  String?
  name                 String
  description          String?
  price                Decimal?               @db.Decimal(10, 2)
  compareAtPrice       Decimal?               @map("compare_at_price") @db.Decimal(10, 2)
  imageUrl             String?                @map("image_url")
  customisationConfig  Json?                  @map("customisation_config")
  isActive             Boolean                @default(true) @map("is_active")
  isFeatured           Boolean                @default(false) @map("is_featured")
  trackStock           Boolean                @default(false) @map("track_stock")
  stockQuantity        Int?                   @map("stock_quantity")
  lowStockThreshold    Int?                   @map("low_stock_threshold")
  stockStatus          StockStatus            @default(IN_STOCK) @map("stock_status")
  allowBackorder       Boolean                @default(false) @map("allow_backorder")
  maxPerOrder          Int?                   @map("max_per_order")
  requiresIdVerification Boolean            @default(false) @map("requires_id_verification")
  sortOrder            Int                    @default(0) @map("sort_order")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  category             MenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  primaryImageAsset    MediaAsset?            @relation("MenuItemPrimaryImage", fields: [primaryImageAssetId], references: [id], onDelete: SetNull)
  availability         MenuItemAvailability[]
  inventoryAdjustments InventoryAdjustment[]
  orderItems           OrderItem[]

  @@map("menu_items")
}

model HubUser {
  id           String         @id @default(uuid()) @db.Uuid
  merchantId   String         @map("business_id") @db.Uuid
  fullName     String         @map("full_name")
  email        String         @unique
  username     String         @unique
  passwordHash String         @map("password_hash")
  role         MembershipRole
  status       HubUserStatus  @default(ACTIVE)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  merchant     Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  menuImportBatches MenuImportBatch[] @relation("HubUserImportBatches")

  @@map("hub_users")
}

model MenuImportBatch {
  id            String              @id @default(uuid()) @db.Uuid
  storeId       String              @map("store_id") @db.Uuid
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  sourceType    MenuImportSourceType @map("source_type")
  sourceLabel   String              @map("source_label")
  status        MenuImportStatus    @default(PENDING_REVIEW)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdByUser HubUser?            @relation("HubUserImportBatches", fields: [createdByUserId], references: [id], onDelete: SetNull)
  candidates    MenuImportCandidate[]

  @@map("menu_import_batches")
}

model MenuImportCandidate {
  id                    String          @id @default(uuid()) @db.Uuid
  batchId               String          @map("batch_id") @db.Uuid
  suggestedCategoryName String          @map("suggested_category_name")
  itemName              String          @map("item_name")
  description           String?
  price                 Decimal         @db.Decimal(10, 2)
  sourceLine            String          @map("source_line")
  sortOrder             Int             @default(0) @map("sort_order")
  createdAt             DateTime        @default(now()) @map("created_at")
  batch                 MenuImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("menu_import_candidates")
}

model MenuItemAvailability {
  id         String   @id @default(cuid())
  menuItemId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Order {
  id              String            @id @default(uuid()) @db.Uuid
  orderNumber     String            @unique @map("order_number")
  customerProfileId String?         @map("customer_profile_id")
  customerAddressId String?         @map("customer_address_id")
  storeId         String            @map("store_id") @db.Uuid
  deliveryZoneId  String?           @map("delivery_zone_id")
  fulfillmentType FulfillmentType   @default(DELIVERY) @map("fulfillment_type")
  source          OrderSource       @default(WEB)
  status          OrderStatus
  paymentStatus   PaymentStatus     @default(PENDING) @map("payment_status")
  paymentMethod   OrderPaymentMethod @default(DOJO_CARD) @map("payment_method")
  customerName    String            @map("customer_name")
  customerPhone   String            @map("customer_phone")
  customerEmail   String?           @map("customer_email")
  addressLine1    String?           @map("address_line_1")
  addressLine2    String?           @map("address_line_2")
  city            String?
  postcode        String?
  notes           String?
  subtotalAmount  Decimal           @map("subtotal_amount") @db.Decimal(10, 2)
  deliveryFee     Decimal           @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount     Decimal           @map("total_amount") @db.Decimal(10, 2)
  currency        String            @db.VarChar(3)
  prepTimeMinutes Int?              @map("prep_time_minutes")
  placedAt        DateTime          @default(now()) @map("placed_at")
  acceptedAt      DateTime?         @map("accepted_at")
  rejectedAt      DateTime?         @map("rejected_at")
  pickedUpAt      DateTime?         @map("picked_up_at")
  deliveredAt     DateTime?         @map("delivered_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  customerProfile CustomerProfile?  @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  customerAddress CustomerAddress?  @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveryZone    DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  delivery        Delivery?
  payment         Payment?
  printJobs       PrintJob[]
  inventoryAdjustments InventoryAdjustment[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  menuItemId   String?  @map("menu_item_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(10, 2)
  nameSnapshot String   @map("name_snapshot")
  notes        String?
  requiresIdVerification Boolean @default(false) @map("requires_id_verification")
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  actorUserId String?     @map("actor_user_id")
  status      OrderStatus
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser   User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("order_status_history")
}

model CourierProfile {
  id            String         @id @default(cuid())
  userId        String         @unique @map("user_id")
  vehicleType   String         @map("vehicle_type")
  vehicleRegistration String?  @map("vehicle_registration")
  isActive      Boolean        @default(true) @map("is_active")
  currentStatus DriverStatus   @default(OFFLINE) @map("current_status")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts        DriverShift[]
  deliveries    Delivery[]
  account       CourierAccount?
  storeAssignments StoreCourierAssignment[]

  @@map("courier_profiles")
}

model CourierAccount {
  id                  String         @id @default(cuid())
  userId              String         @unique @map("user_id")
  courierProfileId    String         @unique @map("courier_profile_id")
  username            String         @unique
  passwordHash        String         @map("password_hash")
  status              HubUserStatus  @default(ACTIVE)
  rating              Decimal        @default(5.0) @db.Decimal(3, 2)
  completedDeliveries Int            @default(0) @map("completed_deliveries")
  weeklyEarnings      Decimal        @default(0) @map("weekly_earnings") @db.Decimal(10, 2)
  rewardPoints        Int            @default(0) @map("reward_points")
  nextPayoutDate      DateTime?      @map("next_payout_date")
  activeSessionId     String?        @map("active_session_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courierProfile      CourierProfile @relation(fields: [courierProfileId], references: [id], onDelete: Cascade)

  @@map("courier_accounts")
}

model DriverShift {
  id               String         @id @default(cuid())
  courierProfileId String         @map("courier_profile_id")
  storeId          String?        @map("store_id") @db.Uuid
  isOnline         Boolean        @default(true) @map("is_online")
  startedAt        DateTime       @default(now()) @map("started_at")
  endedAt          DateTime?      @map("ended_at")
  courierProfile   CourierProfile @relation(fields: [courierProfileId], references: [id], onDelete: Cascade)

  @@map("driver_shifts")
}

model Delivery {
  id                String                  @id @default(uuid()) @db.Uuid
  orderId           String                  @unique @map("order_id") @db.Uuid
  courierProfileId  String?                 @map("courier_profile_id")
  assignedByUserId  String?                 @map("assigned_by_user_id")
  status            DeliveryStatus          @default(UNASSIGNED)
  assignedAt        DateTime?               @map("assigned_at")
  acceptedAt        DateTime?               @map("accepted_at")
  pickedUpAt        DateTime?               @map("picked_up_at")
  deliveredAt       DateTime?               @map("delivered_at")
  externalProvider  String?                 @map("external_provider")
  externalReference String?                 @map("external_reference")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierProfile    CourierProfile?         @relation(fields: [courierProfileId], references: [id], onDelete: SetNull)
  assignedByUser    User?                   @relation("DeliveryAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  statusHistory     DeliveryStatusHistory[]

  @@map("deliveries")
}

model DeliveryStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  deliveryId  String         @map("delivery_id") @db.Uuid
  actorUserId String?        @map("actor_user_id")
  status      DeliveryStatus
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at")
  delivery    Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("delivery_status_history")
}

model Printer {
  id          String             @id @default(uuid()) @db.Uuid
  storeId     String             @map("store_id") @db.Uuid
  name        String
  adapterType PrinterAdapterType @map("adapter_type")
  config      Json
  isDefault   Boolean            @default(false) @map("is_default")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  printJobs   PrintJob[]

  @@map("printers")
}

model PrintJob {
  id          String         @id @default(uuid()) @db.Uuid
  printerId   String         @map("printer_id") @db.Uuid
  orderId     String?        @map("order_id") @db.Uuid
  status      PrintJobStatus @default(QUEUED)
  payload     Json
  attempts    Int            @default(0)
  lastError   String?        @map("last_error")
  createdAt   DateTime       @default(now()) @map("created_at")
  processedAt DateTime?      @map("processed_at")
  completedAt DateTime?      @map("completed_at")
  printer     Printer        @relation(fields: [printerId], references: [id], onDelete: Cascade)
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("print_jobs")
}

model Payment {
  id                    String              @id @default(cuid())
  orderId               String              @unique
  customerProfileId     String?
  provider              PaymentProvider     @default(STRIPE)
  status                PaymentRecordStatus
  methodType            PaymentMethodType?
  stripeCustomerId      String?
  stripePaymentIntentId String?             @unique
  stripeChargeId        String?
  dojoCustomerId        String?             @map("dojo_customer_id")
  dojoPaymentIntentId   String?             @unique @map("dojo_payment_intent_id")
  amount                Decimal             @db.Decimal(10, 2)
  currency              String              @db.VarChar(3)
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerProfile       CustomerProfile?    @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  events                PaymentEvent[]
}

model PaymentEvent {
  id            String               @id @default(cuid())
  paymentId     String
  stripeEventId String?              @unique
  type          String
  status        PaymentRecordStatus?
  payload       Json
  createdAt     DateTime             @default(now())
  payment       Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model InventoryAdjustment {
  id          String                    @id @default(cuid())
  menuItemId  String
  actorUserId String?
  sourceOrderId String?
  quantityDelta Int
  reason      InventoryAdjustmentReason
  note        String?
  createdAt   DateTime                  @default(now())
  menuItem     MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  actorUser    User?                    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  sourceOrder  Order?                   @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
}

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventName     String
  payload       Json
  createdAt     DateTime @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model ServiceCategory {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  slug      String           @unique
  imageUrl  String?          @map("image_url")
  icon      String?
  active    Boolean          @default(true)
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  listings  ServiceListing[]

  @@map("service_categories")
}

model ServiceBusiness {
  id           String                @id @default(uuid()) @db.Uuid
  businessName String                @map("business_name")
  ownerUserId  String?               @map("owner_user_id")
  description  String?
  phone        String?
  email        String?
  location     String?
  coverageArea String?               @map("coverage_area")
  status       ServiceBusinessStatus @default(PENDING)
  verified     Boolean               @default(false)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  owner        User?                 @relation("ServiceBusinessOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  listings     ServiceListing[]

  @@map("service_businesses")
}

model ServiceListing {
  id                String           @id @default(uuid()) @db.Uuid
  serviceBusinessId String           @map("service_business_id") @db.Uuid
  categoryId        String           @map("category_id") @db.Uuid
  title             String
  description       String?
  priceFrom         Decimal?         @map("price_from") @db.Decimal(10, 2)
  images            String[]         @default([])
  availability      Json?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  serviceBusiness   ServiceBusiness  @relation(fields: [serviceBusinessId], references: [id], onDelete: Cascade)
  category          ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, active])
  @@index([serviceBusinessId, active])
  @@map("service_listings")
}

// --- Hull Marketplace (local resale, Vinted-style offers + messages) ---

enum ResaleListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED

  @@map("resale_listing_status")
}

enum ResaleDeliveryMode {
  COLLECTION
  SMALL_DELIVERY
  VAN_REQUIRED

  @@map("resale_delivery_mode")
}

enum ResaleOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@map("resale_offer_status")
}

enum ResalePurchaseStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  NOT_SOLD

  @@map("resale_purchase_status")
}

enum ResaleMessageKind {
  TEXT
  SYSTEM

  @@map("resale_message_kind")
}

model ResaleListing {
  id                    String              @id @default(cuid())
  sellerCustomerProfileId String            @map("seller_customer_profile_id")
  title                 String
  description           String?
  categorySlug          String              @map("category_slug")
  conditionLabel        String              @map("condition_label")
  pricePence            Int                 @map("price_pence")
  currency              String              @default("GBP") @db.VarChar(3)
  deliveryMode          ResaleDeliveryMode  @map("delivery_mode")
  imageUrls             String[]            @default([]) @map("image_urls")
  acceptsOffers         Boolean             @default(true) @map("accepts_offers")
  status                ResaleListingStatus @default(AVAILABLE)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  seller                CustomerProfile     @relation("ResaleListingSeller", fields: [sellerCustomerProfileId], references: [id], onDelete: Cascade)
  conversations         ResaleConversation[]
  purchases             ResalePurchase[]
  reviews               ResaleReview[]
  resolutionCases       ResaleResolutionCase[]

  @@index([sellerCustomerProfileId, status])
  @@index([status, createdAt])
  @@map("resale_listings")
}

model ResaleConversation {
  id                      String            @id @default(cuid())
  listingId               String            @map("listing_id")
  buyerCustomerProfileId  String            @map("buyer_customer_profile_id")
  sellerCustomerProfileId String            @map("seller_customer_profile_id")
  lastMessageAt           DateTime?         @map("last_message_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  listing                 ResaleListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer                   CustomerProfile   @relation("ResaleConversationBuyer", fields: [buyerCustomerProfileId], references: [id], onDelete: Cascade)
  seller                  CustomerProfile   @relation("ResaleConversationSeller", fields: [sellerCustomerProfileId], references: [id], onDelete: Cascade)
  messages                ResaleMessage[]
  offers                  ResaleOffer[]
  purchases               ResalePurchase[]

  @@unique([listingId, buyerCustomerProfileId])
  @@index([buyerCustomerProfileId, lastMessageAt])
  @@index([sellerCustomerProfileId, lastMessageAt])
  @@map("resale_conversations")
}

model ResaleMessage {
  id                       String           @id @default(cuid())
  conversationId           String           @map("conversation_id")
  senderCustomerProfileId  String           @map("sender_customer_profile_id")
  body                     String
  kind                     ResaleMessageKind @default(TEXT)
  createdAt                DateTime         @default(now()) @map("created_at")
  conversation             ResaleConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                   CustomerProfile  @relation("ResaleMessageSender", fields: [senderCustomerProfileId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("resale_messages")
}

model ResaleOffer {
  id                        String          @id @default(cuid())
  conversationId            String          @map("conversation_id")
  offeredByCustomerProfileId String         @map("offered_by_customer_profile_id")
  amountPence               Int             @map("amount_pence")
  currency                  String          @default("GBP") @db.VarChar(3)
  status                    ResaleOfferStatus @default(PENDING)
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")
  conversation              ResaleConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  offeredBy                 CustomerProfile @relation("ResaleOfferAuthor", fields: [offeredByCustomerProfileId], references: [id], onDelete: Cascade)
  purchaseWhereAccepted     ResalePurchase? @relation("ResalePurchaseAcceptedOffer")

  @@index([conversationId, status])
  @@map("resale_offers")
}

model ResalePurchase {
  id                       String               @id @default(cuid())
  listingId                String               @map("listing_id")
  conversationId         String?              @map("conversation_id")
  buyerCustomerProfileId String               @map("buyer_customer_profile_id")
  amountPence            Int                  @map("amount_pence")
  currency               String               @default("GBP") @db.VarChar(3)
  status                 ResalePurchaseStatus @default(PENDING_PAYMENT)
  acceptedOfferId        String?              @unique @map("accepted_offer_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  listing                ResaleListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  conversation           ResaleConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  buyer                  CustomerProfile      @relation("ResalePurchaseBuyer", fields: [buyerCustomerProfileId], references: [id], onDelete: Cascade)
  acceptedOffer          ResaleOffer?         @relation("ResalePurchaseAcceptedOffer", fields: [acceptedOfferId], references: [id], onDelete: SetNull)
  paidAt                 DateTime?            @map("paid_at")
  buyerReview            ResaleReview?
  resolutionCases        ResaleResolutionCase[]

  @@index([listingId, status])
  @@index([buyerCustomerProfileId, status])
  @@map("resale_purchases")
}

enum ResaleResolutionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("resale_resolution_status")
}

enum ResaleResolutionCategory {
  ITEM_NOT_AS_DESCRIBED
  PAYMENT_OR_PICKUP
  HARASSMENT_OR_SAFETY
  OTHER

  @@map("resale_resolution_category")
}

model ResaleReview {
  id                          String          @id @default(cuid())
  purchaseId                  String          @unique @map("purchase_id")
  listingId                   String          @map("listing_id")
  reviewerCustomerProfileId   String          @map("reviewer_customer_profile_id")
  ratingTenths                Int             @map("rating_tenths")
  comment                     String?
  createdAt                   DateTime        @default(now()) @map("created_at")
  purchase                    ResalePurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  listing                     ResaleListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer                    CustomerProfile @relation("ResaleReviewAuthor", fields: [reviewerCustomerProfileId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([reviewerCustomerProfileId, createdAt])
  @@map("resale_reviews")
}

model ResaleResolutionCase {
  id                        String                  @id @default(cuid())
  openedByCustomerProfileId String                 @map("opened_by_customer_profile_id")
  purchaseId                String?                 @map("purchase_id")
  listingId                 String?                 @map("listing_id")
  category                  ResaleResolutionCategory
  summary                   String
  details                   String
  status                    ResaleResolutionStatus  @default(OPEN)
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  openedBy                  CustomerProfile         @relation("ResaleResolutionOpener", fields: [openedByCustomerProfileId], references: [id], onDelete: Cascade)
  purchase                  ResalePurchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  listing                   ResaleListing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([openedByCustomerProfileId, status])
  @@index([status, createdAt])
  @@map("resale_resolution_cases")
}
